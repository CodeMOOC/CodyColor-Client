# Copy this file to config.env to setup services

# MySQL
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_ROOT_PASSWORD=

# RabbitMQ STOMP — used by the "website" (Angular client) service
RABBIT_USERNAME=
RABBIT_PASSWORD=
RABBIT_VHOST=/

# Public-facing URLs — used by the "website" (Angular client) service
RABBIT_SOCKET_URL=wss://codycolor.codyroby.it/api/ws
WEB_BASE_URL=https://codycolor.codyroby.it
